# Copy this file to .env and fill in values. Never commit .env.

# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# Service role key. Collectors only. Full write access, keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Contact sent in the User-Agent header. Some sources (like the SEC) require it.
CONTACT_EMAIL=
